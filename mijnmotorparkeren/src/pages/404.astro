---
import '@fontsource-variable/inter/wght.css'
import { MapPinOff, Map } from 'lucide-react'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Pagina niet gevonden | MijnMotorParkeren.nl"
  description="Deze pagina bestaat niet. Ga terug naar de kaart en zoek de parkeerregels voor motoren in jouw gemeente."
  noindex
>
  <div class="viewport-full flex flex-col bg-white text-gray-900">
    <header class="border-b border-gray-200 bg-white shadow-sm">
      <div class="mx-auto flex min-h-14 max-w-7xl items-center px-4 py-1 sm:min-h-16 sm:px-6 lg:px-8">
        <a
          href="/"
          class="-ml-1.5 flex min-h-11 items-center gap-2 rounded pr-2 text-lg font-semibold focus:outline-none focus:ring-2 focus:ring-blue-400 sm:text-xl"
        >
          <img src="/logo.svg" alt="" class="aspect-square h-8 object-contain sm:h-10" />
          MijnMotorParkeren.nl
        </a>
      </div>
    </header>

    <main class="flex flex-1 flex-col items-center justify-center px-4 py-12 text-center">
      <MapPinOff className="size-12 text-brand-green-text" strokeWidth={1.5} aria-hidden="true" />
      <h1 class="mt-5 text-2xl font-semibold text-balance sm:text-3xl">
        Deze pagina staat niet op de kaart
      </h1>
      <p class="mt-3 max-w-md text-pretty text-gray-600">
        De link klopt niet, of de pagina is verplaatst. Op de kaart zoek je zo de parkeerregels van
        je gemeente op.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-lg bg-blue-600 px-5 font-medium text-white transition-colors duration-150 ease-out hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 motion-reduce:transition-none"
      >
        <Map className="size-4" aria-hidden="true" />
        Terug naar de kaart
      </a>
    </main>
  </div>
</BaseLayout>
